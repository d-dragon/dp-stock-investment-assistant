{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d-dragon.github.io/dp-stock-investment-assistant/sites/data/schema/news.schema.json",
  "title": "DP Stock ranked daily news + feeds file",
  "description": "Shape of docs/sites/data/YYYY-MM/n/YYYY-MM-DD.json. Loader report-app.js attachNewsFeed() sorts by impactScore then publishedAt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "date", "items"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "generatedAt": { "type": "string" },
    "briefKind": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "url", "sourceId"],
        "properties": {
          "id": { "type": "string" },
          "impact": { "enum": ["high", "medium", "low"] },
          "impactLevel": { "enum": ["high", "medium", "low"] },
          "impactScore": { "type": "number", "minimum": 0, "maximum": 100 },
          "rank": { "type": "integer", "minimum": 1 },
          "kind": { "enum": ["news", "disclosure", "macro", "market", "community"] },
          "board": { "enum": ["global", "vn"] },
          "region": { "enum": ["global", "vn"] },
          "title": { "type": "string", "minLength": 4 },
          "url": { "type": "string" },
          "sourceId": { "type": "string", "pattern": "^src-" },
          "publishedAt": { "type": "string" },
          "date": { "type": "string" },
          "tickers": { "type": "array", "items": { "type": "string" } },
          "excerpt": { "type": "string" },
          "summary": { "type": "string" },
          "whyImpact": { "type": "string" },
          "image": { "type": "object" }
        }
      }
    }
  }
}
