{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d-dragon.github.io/dp-stock-investment-assistant/sites/data/schema/week.schema.json",
  "title": "DP Stock weekly market-brief file",
  "description": "Canonical shape for docs/sites/data/YYYY-MM/week-WW.json. Golden reference: 2026-09/week-38.json. Agents MUST validate against this file before push.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "yearMonth", "week", "updatedAt", "days"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "yearMonth": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "updatedAt": { "$ref": "#/$defs/iso8601vn" },
    "week": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isoYear", "isoWeek", "id", "start", "end"],
      "properties": {
        "isoYear": { "type": "integer", "minimum": 2020 },
        "isoWeek": { "type": "integer", "minimum": 1, "maximum": 53 },
        "id": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
        "start": { "$ref": "#/$defs/ymd" },
        "end": { "$ref": "#/$defs/ymd" }
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/dayEntry" }
    }
  },
  "$defs": {
    "ymd": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "iso8601vn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?\\+07:00$" },
    "numOrNull": { "type": ["number", "null"] },
    "direction": { "enum": ["risk_on", "risk_off", "mixed", "neutral"] },
    "horizon": { "enum": ["intraday", "days", "weeks", "months", "quarters"] },
    "session": { "enum": ["preopen", "intraday", "close", "closed", "afterhours", "prior_close"] },
    "assetClass": { "enum": ["equity_index", "fx", "commodity", "crypto", "rates"] },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "horizon", "assets", "text"],
      "properties": {
        "direction": { "$ref": "#/$defs/direction" },
        "horizon": { "$ref": "#/$defs/horizon" },
        "assets": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 16 } },
        "text": { "type": "string", "minLength": 8, "maxLength": 280 }
      }
    },
    "snapshotQuote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "nameVi", "price", "changePct", "sourceId"],
      "properties": {
        "symbol": { "type": "string", "minLength": 1, "maxLength": 16 },
        "nameVi": { "type": "string", "minLength": 1, "maxLength": 40 },
        "assetClass": { "$ref": "#/$defs/assetClass" },
        "price": { "type": "number" },
        "change": { "$ref": "#/$defs/numOrNull" },
        "changePct": { "$ref": "#/$defs/numOrNull" },
        "session": { "$ref": "#/$defs/session" },
        "sourceId": { "type": "string", "pattern": "^src-" }
      }
    },
    "boardQuote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "nameVi", "price", "changePct"],
      "properties": {
        "symbol": { "type": "string", "minLength": 1, "maxLength": 16 },
        "nameVi": { "type": "string", "minLength": 1, "maxLength": 40 },
        "assetClass": { "$ref": "#/$defs/assetClass" },
        "price": { "type": "number" },
        "change": { "$ref": "#/$defs/numOrNull" },
        "changePct": { "type": "number" },
        "sourceId": { "type": "string", "pattern": "^src-" }
      }
    },
    "newsItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "date", "title", "summary", "impact", "sourceId"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 16 },
        "date": { "$ref": "#/$defs/iso8601vn" },
        "title": { "type": "string", "minLength": 8, "maxLength": 160 },
        "summary": { "type": "string", "minLength": 12, "maxLength": 320 },
        "impact": { "$ref": "#/$defs/impact" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": { "url": { "type": "string", "maxLength": 200 } }
        },
        "sourceId": { "type": "string", "pattern": "^src-" }
      }
    },
    "macroItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["indicator", "nameVi", "value", "unit", "sourceId"],
      "properties": {
        "indicator": { "enum": ["CPI", "M2", "GDP", "CREDIT", "FX", "RATES", "FDI", "OMO", "FUEL", "BONDS", "POLICY"] },
        "nameVi": { "type": "string", "minLength": 2, "maxLength": 40 },
        "value": { "$ref": "#/$defs/numOrNull" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 16 },
        "sourceId": { "type": "string", "pattern": "^src-" }
      }
    },
    "companyItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticker", "headline", "impact", "metrics", "sourceId"],
      "properties": {
        "ticker": { "type": "string", "minLength": 2, "maxLength": 12 },
        "headline": { "type": "string", "minLength": 8, "maxLength": 160 },
        "impact": { "$ref": "#/$defs/impact" },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "changePct": { "$ref": "#/$defs/numOrNull" },
            "price": { "$ref": "#/$defs/numOrNull" }
          }
        },
        "sourceId": { "type": "string", "pattern": "^src-" }
      }
    },
    "lineSeries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "interpolation", "points"],
      "properties": {
        "id": { "type": "string" },
        "interpolation": { "enum": ["official", "anchored"] },
        "points": {
          "type": "array",
          "minItems": 2,
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["t", "v"],
            "properties": {
              "t": { "type": "string", "minLength": 4, "maxLength": 16 },
              "v": { "type": "number" }
            }
          }
        }
      }
    },
    "volume5d": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labels", "volumeMillionShares", "valueVndTn"],
      "properties": {
        "labels": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string" } },
        "volumeMillionShares": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "$ref": "#/$defs/numOrNull" } },
        "valueVndTn": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "$ref": "#/$defs/numOrNull" } }
      }
    },
    "foreign5d": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labels", "values"],
      "properties": {
        "labels": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string" } },
        "values": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "$ref": "#/$defs/numOrNull" } }
      }
    },
    "sourceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "url", "accessedAt", "reliability"],
      "properties": {
        "id": { "type": "string", "pattern": "^src-" },
        "name": { "type": "string", "minLength": 2, "maxLength": 48 },
        "url": { "type": "string", "minLength": 8, "maxLength": 200 },
        "accessedAt": { "$ref": "#/$defs/iso8601vn" },
        "reliability": { "enum": ["primary", "secondary"] }
      }
    },
    "dayEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "report", "sources"],
      "properties": {
        "date": { "$ref": "#/$defs/ymd" },
        "report": { "$ref": "#/$defs/report" },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "sources"],
          "properties": {
            "schemaVersion": { "const": "1.0.0" },
            "sources": { "type": "array", "minItems": 4, "maxItems": 32, "items": { "$ref": "#/$defs/sourceItem" } }
          }
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "type", "locale", "timezone", "generatedAt", "coverage", "marketSession", "disclaimer", "ui", "snapshot", "globalNews", "vietnamNews", "vietnamMacro", "equityMarket", "worldMarkets", "cryptoMarkets", "companies", "outlook", "series"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "id": { "type": "string", "pattern": "^daily-brief-[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "type": { "const": "daily_market_brief" },
        "locale": { "const": "vi-VN" },
        "timezone": { "const": "Asia/Ho_Chi_Minh" },
        "generatedAt": { "$ref": "#/$defs/iso8601vn" },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to", "session"],
          "properties": {
            "from": { "$ref": "#/$defs/iso8601vn" },
            "to": { "$ref": "#/$defs/iso8601vn" },
            "session": { "$ref": "#/$defs/session" }
          }
        },
        "marketSession": { "$ref": "#/$defs/session" },
        "disclaimer": { "type": "string", "minLength": 20, "maxLength": 400 },
        "ui": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pageSizeNews", "defaultChartTab", "defaultWorldSymbol"],
          "properties": {
            "pageSizeNews": { "type": "integer", "minimum": 4, "maximum": 12 },
            "defaultChartTab": { "enum": ["vnindex", "world", "crypto"] },
            "defaultWorldSymbol": { "type": "string" }
          }
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quotes"],
          "properties": {
            "quotes": { "type": "array", "minItems": 10, "maxItems": 16, "items": { "$ref": "#/$defs/snapshotQuote" } }
          }
        },
        "globalNews": { "type": "array", "minItems": 8, "maxItems": 12, "items": { "$ref": "#/$defs/newsItem" } },
        "vietnamNews": { "type": "array", "minItems": 8, "maxItems": 12, "items": { "$ref": "#/$defs/newsItem" } },
        "vietnamMacro": { "type": "array", "minItems": 8, "maxItems": 12, "items": { "$ref": "#/$defs/macroItem" } },
        "equityMarket": {
          "type": "object",
          "additionalProperties": false,
          "required": ["index", "liquidity", "foreign", "proprietary", "retail", "relatedIndices"],
          "properties": {
            "index": {
              "type": "object",
              "additionalProperties": false,
              "required": ["priorClose", "latest"],
              "properties": {
                "priorClose": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["date", "price"],
                  "properties": {
                    "date": { "$ref": "#/$defs/ymd" },
                    "price": { "type": "number" },
                    "change": { "$ref": "#/$defs/numOrNull" },
                    "changePct": { "$ref": "#/$defs/numOrNull" }
                  }
                },
                "latest": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["date", "price", "change", "changePct", "session"],
                  "properties": {
                    "date": { "$ref": "#/$defs/ymd" },
                    "open": { "$ref": "#/$defs/numOrNull" },
                    "high": { "$ref": "#/$defs/numOrNull" },
                    "low": { "$ref": "#/$defs/numOrNull" },
                    "price": { "type": "number" },
                    "change": { "$ref": "#/$defs/numOrNull" },
                    "changePct": { "$ref": "#/$defs/numOrNull" },
                    "session": { "$ref": "#/$defs/session" },
                    "weekChange": { "$ref": "#/$defs/numOrNull" },
                    "weekChangePct": { "$ref": "#/$defs/numOrNull" }
                  }
                }
              }
            },
            "liquidity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["hose"],
              "properties": {
                "hose": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["volumeShares", "valueVndBn"],
                  "properties": {
                    "volumeShares": { "$ref": "#/$defs/numOrNull" },
                    "valueVndBn": { "$ref": "#/$defs/numOrNull" },
                    "valueChangePct": { "$ref": "#/$defs/numOrNull" },
                    "note": { "type": "string", "maxLength": 220 }
                  }
                }
              }
            },
            "foreign": {
              "type": "object",
              "additionalProperties": false,
              "required": ["netValueVndBn"],
              "properties": {
                "buyValueVndBn": { "$ref": "#/$defs/numOrNull" },
                "sellValueVndBn": { "$ref": "#/$defs/numOrNull" },
                "netValueVndBn": { "$ref": "#/$defs/numOrNull" },
                "note": { "type": "string", "maxLength": 220 }
              }
            },
            "proprietary": {
              "type": "object",
              "additionalProperties": false,
              "required": ["netValueVndBn"],
              "properties": {
                "netValueVndBn": { "$ref": "#/$defs/numOrNull" },
                "note": { "type": "string", "maxLength": 160 }
              }
            },
            "retail": {
              "type": "object",
              "additionalProperties": false,
              "required": ["netValueVndBn"],
              "properties": {
                "netValueVndBn": { "$ref": "#/$defs/numOrNull" },
                "note": { "type": "string", "maxLength": 160 }
              }
            },
            "relatedIndices": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["symbol", "price", "changePct"],
                "properties": {
                  "symbol": { "type": "string" },
                  "price": { "type": "number" },
                  "changePct": { "type": "number" }
                }
              }
            }
          }
        },
        "worldMarkets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quotes"],
          "properties": {
            "quotes": { "type": "array", "minItems": 6, "maxItems": 10, "items": { "$ref": "#/$defs/boardQuote" } }
          }
        },
        "cryptoMarkets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quotes"],
          "properties": {
            "quotes": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "$ref": "#/$defs/boardQuote" } }
          }
        },
        "companies": { "type": "array", "minItems": 5, "maxItems": 8, "items": { "$ref": "#/$defs/companyItem" } },
        "outlook": {
          "type": "object",
          "additionalProperties": false,
          "required": ["watchpoints", "levels", "events"],
          "properties": {
            "stance": { "type": "string", "maxLength": 80 },
            "summary": { "type": "string", "maxLength": 280 },
            "watchpoints": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["text", "impact"],
                "properties": {
                  "text": { "type": "string", "minLength": 4, "maxLength": 120 },
                  "impact": { "$ref": "#/$defs/impact" }
                }
              }
            },
            "levels": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["symbol", "kind", "price", "note"],
                "properties": {
                  "symbol": { "type": "string" },
                  "kind": { "enum": ["support", "resistance"] },
                  "price": { "type": "number" },
                  "note": { "type": "string", "maxLength": 80 }
                }
              }
            },
            "events": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["when", "title", "impact"],
                "properties": {
                  "when": { "type": "string", "minLength": 8, "maxLength": 32 },
                  "title": { "type": "string", "minLength": 4, "maxLength": 140 },
                  "impact": { "$ref": "#/$defs/impact" }
                }
              }
            }
          }
        },
        "series": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vnindex", "dji", "ndx", "spx", "dxy", "nky", "hsi", "btcUsd", "vnindexVolume5d", "foreignNet5dVndBn"],
          "properties": {
            "vnindex": { "$ref": "#/$defs/lineSeries" },
            "dji": { "$ref": "#/$defs/lineSeries" },
            "ndx": { "$ref": "#/$defs/lineSeries" },
            "spx": { "$ref": "#/$defs/lineSeries" },
            "dxy": { "$ref": "#/$defs/lineSeries" },
            "nky": { "$ref": "#/$defs/lineSeries" },
            "hsi": { "$ref": "#/$defs/lineSeries" },
            "btcUsd": { "$ref": "#/$defs/lineSeries" },
            "vnindexVolume5d": { "$ref": "#/$defs/volume5d" },
            "foreignNet5dVndBn": { "$ref": "#/$defs/foreign5d" }
          }
        }
      }
    }
  }
}
