{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d-dragon.github.io/dp-stock-investment-assistant/sites/data/schema/catalog.schema.json",
  "title": "DP Stock daily-brief catalog",
  "description": "Shape of docs/sites/data/index.json. Binding: report-app.js loadCatalog() → reports[].date / weekPath / path / title.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "layout", "reports"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "updatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?\\+07:00$"
    },
    "layout": { "const": "monthly-weekly" },
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "date", "title", "status", "weekId", "weekPath", "path"],
        "properties": {
          "id": { "type": "string", "pattern": "^daily-brief-[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "title": { "type": "string", "minLength": 8, "maxLength": 80 },
          "status": { "enum": ["preopen", "intraday", "closed", "afterhours"] },
          "weekId": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
          "weekPath": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}/week-[0-9]{2}\\.json$" },
          "path": { "type": "string", "pattern": "^index\\.html#/[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        }
      }
    }
  }
}
