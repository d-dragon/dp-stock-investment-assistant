# Template only. Vite does not load this file.
# The live copies are .env.development, .env.production, and .env.test.
# Empty means same origin. The Vite dev server proxies /api to the Backend.
VITE_API_BASE_URL=

# Stopgap idle window for the chat stream, in milliseconds, until the Backend
# sends heartbeat comments. Change the value in the live env file.
VITE_STREAM_IDLE_TIMEOUT_MS=60000
